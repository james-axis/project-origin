# =====================================================
# AXIS CRM - TWILIO INTEGRATION ENVIRONMENT VARIABLES
# =====================================================
# Copy this file to .env and fill in your values

# Twilio Credentials (from twilio.com/console)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Twilio API Key (for client tokens - Stage 9)
TWILIO_API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# TwiML App SID (created in Twilio Console for softphone)
TWILIO_TWIML_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Base URL for webhooks (your public server URL)
BASE_URL=https://your-api-domain.com

# PostgreSQL Database
DATABASE_URL=postgres://user:password@host:5432/axis_crm

# Server
PORT=3001
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Compliance email (for regulatory bundles)
COMPLIANCE_EMAIL=compliance@axis.com.au

# S3/Storage for audio files (Stage 4)
S3_BUCKET=axis-audio-files
S3_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
